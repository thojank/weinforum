# Kopieren nach .env.local und ausfüllen. .env.local wird nicht eingecheckt.
# Auf Vercel dieselben Namen unter Settings → Environment Variables anlegen.

# Baserow (Cloud: https://api.baserow.io)
BASEROW_API_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_TABLE_WEINE=

# Sprachmodell zum Lesen der Etiketten (Anbieter noch nicht festgelegt)
MODELL_API_KEY=

# Einfacher Zugangsschutz der App, bis eine Anmeldung gebaut ist
APP_ZUGANGSCODE=
