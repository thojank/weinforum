# Kopieren nach .env.local und ausfüllen. .env.local wird nicht eingecheckt.
# Auf Vercel dieselben Namen unter Settings → Environment Variables anlegen.

# Baserow (Cloud: https://api.baserow.io)
BASEROW_API_URL=https://api.baserow.io
BASEROW_TOKEN=
BASEROW_TABLE_WEINE=

# Sprachmodell zum Lesen der Etiketten, über OpenRouter (https://openrouter.ai)
# Das Modell lässt sich hier tauschen, ohne den Code zu ändern.
OPENROUTER_API_KEY=
MODELL_ID=google/gemini-3.1-flash-lite

# Gemeinsamer Zugangscode der App. Im Betrieb (Vercel) Pflicht: ohne ihn bleibt die Seite zu.
# Auf dem eigenen Rechner darf er leer bleiben.
APP_ZUGANGSCODE=
